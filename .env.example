# Trading mode: intraday | long_term
TRADING_MODE=intraday

# Comma-separated watchlist
WATCHLIST=NVDA,MSFT,AAPL,PLTR,JPM,GS,V,LLY,UNH,ISRG,XOM,NEE,AMZN,WMT,TSLA,CAT,BA,META,GOOGL,FCX

# Alpaca paper trading credentials
ALPACA_API_KEY="***REMOVED-ALPACA-API-KEY***"
ALPACA_SECRET_KEY="***REMOVED-ALPACA-SECRET-KEY***"
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# News data sources
FINNHUB_API_KEY="***REMOVED-FINNHUB-API-KEY***"
POLYGON_API_KEY="***REMOVED-POLYGON-API-KEY***"
BENZINGA_API_KEY="***REMOVED-BENZINGA-API-KEY***"

# LLM backend — Ollama is default (local), Claude API is optional override
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
ANTHROPIC_API_KEY=

# Database
DB_PATH=trading_agent.db

# Risk parameters
MAX_POSITION_SIZE_PCT=0.05
MAX_PORTFOLIO_RISK_PCT=0.02
MAX_CONCURRENT_TRADES=20
STOP_LOSS_ATR_MULT=2.0
TAKE_PROFIT_ATR_MULT=4.0

# Execution
PAPER_TRADING=true

# Logging
LOG_LEVEL=INFO
